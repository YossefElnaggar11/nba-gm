# Frontend env vars. Copy to .env.local for local dev (defaults to localhost backend).
# On Vercel, set NEXT_PUBLIC_API_URL in Project Settings → Environment Variables
# to the Render backend URL once it's deployed, e.g.:
#   NEXT_PUBLIC_API_URL=https://nba-gm-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
